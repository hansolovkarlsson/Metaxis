/* Fizz */
#include <stdio.h>
int total, mod;
int i;
void Show(int n) {
printf("%d\n", n);
}
void Pair(int a, int b) {
printf("%d\n", a + b);
}
int Double(int n) {
return n * 2;
}
int main(void) {
total = 0;
mod = 3;
for (int i = 1; i <= 20; i++) if ((i % mod == 0) && (i != 9)) total = total + i; else total = total - 1;
if (!(total > 100)) puts("it's middling"); else puts("big");
if (total > 30) {
total = total + 1;
printf("%d\n", total);
} else printf("%d\n", total);
Show(Double(total));
Pair(total, 2);
return 0;
}
