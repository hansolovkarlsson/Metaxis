; cpp.mx -- a C preprocessor, in text mode. Stage 6's rules.
;
; C in, C out, and the mechanic they drive is the store (REFERENCE §8.5).
; A preprocessor is the smallest real program whose entire job is a symbol
; table: `#define` puts a name in it and every later line is read against
; it, in order, so a macro defined below its use is not expanded. That is
; exactly what a rule could not do before 2026-09-07 -- a rule saw its own
; pattern and nothing else -- and what `remember` and `recall` are for.
;
; These are rules and no body, so they are used rather than run:
; `examples/cpp.mx` is a program that `@use`s them, and
; `mx -u lib/cpp.mx -i prog.c -o prog.i` points them at a C file that says
; nothing about any grammar, which is REFERENCE §9's second form and what
; makes this file a stage in somebody else's toolchain rather than an
; example of its own.
;
; The rules. `#define NAME body` remembers the body under the name and
; emits nothing, so the line goes; `#define NAME(a, b) body` remembers a
; body and its parameters; `#undef NAME` forgets; a rule on every call binds
; a macro's arguments to its parameters through the store and expands the
; body; a rule led by a class hole, `x:name`, fires on every identifier
; in the file and emits an argument, a macro's body, or the identifier
; itself, in that order of preference; and `#ifdef`, `#ifndef`, `#elif`,
; `#else` and `#endif` take one arm and drop the rest unread. The four
; classes are C's, as in lib/island.mx, so that a macro name inside a string,
; a character literal or a comment is a token the scan passes over and never
; a name the third rule sees; the three brackets keep a hole over `(a, b)`
; whole.
;
; What these rules do not do, said plainly. A directive wants
; exactly one space after its word and before its body, because text mode
; matches a word byte for byte; `#  define` and a tab do not read, and a
; function-like macro's parameters are written `(a, b)` with that one space.
; An argument that forms a call with the text after it, `CALL(F)` for
; `#define CALL(f) f(1)`, is not rescanned as a call, where cpp would expand
; `F(1)`. A conditional's word ends its line, so `#ifdef X` reads and
; `#ifdef X /* why */` does not; there is no `#if` over an expression, and
; the one condition a `#elif` may carry is `defined(NAME)`, so `#elif !defined(X)`
; and `#elif A && B` do not read. Those are **refused** rather than passed
; through, for the reason written above the rule that refuses them: everything
; else these rules do not read is still C for the compiler behind them, and a
; `#elif` is not, because it stands inside a conditional they do read. A
; condition standing after the arm that was taken is not read at all, and is
; not refused either, since cpp does not evaluate it there and the answer is
; the same without it.
; An included file is read once per include and is not searched
; for on any path but beside the file being expanded, which under `-i` is
; the input and not this one. `#x` quotes the argument after it
; has been expanded, where cpp quotes it as written, so `STR(LIMIT)` is
; `"10"` here and `"LIMIT"` there; and an argument keeps the whitespace it
; was written with, so `#x` of ` hello` has the leading space. Everything
; the item listed is read; what the tool had to grow for it is in
; docs/COMPLETED.md, and each thing above is a rule, not a change to it.
; `#include <stdio.h>` is not a directive these rules know, so it goes
; through whole, which is right: the output is C for a compiler that has a
; preprocessor of its own.
;
; tests/cpp.sh runs the body of `examples/cpp.mx` through these rules two
; ways, as that file and as `-u` over the same body extracted to a `.c`,
; compiles what comes out and runs it, and runs the same body through the C
; compiler directly, whose own preprocessor is the oracle.

@mode text

@token name    "[A-Za-z_][A-Za-z0-9_]*"
@token string  "\"([^\"\\\\]|\\\\.)*\""
@token char    "'([^'\\\\]|\\\\.)*'"
@token comment "/\\*([^*]|\\*+[^*/])*\\*+/"

@bracket "(" ")"
@bracket "[" "]"
@bracket "{" "}"

; The conditionals nest, so an arm has to run to its own `#endif` and not
; the first one it meets, which is what a declared bracket gives a hole.
; Two opens share the close, since a close balances whichever open stands
; behind it.
@bracket "#ifdef"  "#endif"
@bracket "#ifndef" "#endif"

; A function-like macro remembers its body under `fn:` and each parameter
; under its position. Declared before the object-like rule, which shares
; its first word: `#define F(x)` has `(` where the other wants a space.
; The body is a `raw` hole, kept as written and expanded at each use by the
; rules below, which is cpp's order: `#define TOTAL (LIMIT * STEP)` names
; whatever `STEP` means where `TOTAL` is used, not where it was defined.
@syntax "#define " n:name "(" [ p:name ]* sep ", " ")" " " b:raw "\n" => {
    remember("fn:" + n, b)
    for i, q in p { remember("param:" + n + ":" + i, q) }
}
@syntax "#define " n:name " " b:raw "\n" => { remember("def:" + n, b) }
@syntax "#define " n:name "\n"           => { remember("def:" + n, "") }
@syntax "#undef " n:name "\n"        => { forget("def:" + n); forget("fn:" + n) }

; `#include "file"` is the file's text, found beside this one, run through
; these rules in its turn: a `#define` in it is known to the lines after the
; include, and a macro used in it is expanded before its text is emitted.
; The string class takes the quoted name whole; `drop` takes the quotes off.
; `#include <stdio.h>` has no rule and goes through for the C compiler.
@syntax "#include " f:string "\n" => { emit expand(read(drop(f, 1, 1))) }

; `#elif` outside any conditional these rules read. Inside one it opens an
; arm, below; here there is nothing for it to be an arm of, and a file that
; spells one there is not C the compiler behind us can be handed, so it is
; refused rather than passed through. This and the refusal in `arms` below
; are the only two things here that are refused: everything else these rules
; do not read is still C for that compiler, `#if`, `#  define`,
; `#include <stdio.h>`. `refuse` is REFERENCE §8.3.
@syntax "#elif" => {
    refuse("'#elif' here stands outside any conditional these rules read, so there is no arm for it to open. Write the conditional it belongs to as an '#ifdef' or an '#ifndef'.")
}

; `defined(NAME)`, the one expression these rules read, and read only where
; an arm is being decided: `cond` is remembered for that moment and forgotten
; before any arm is expanded, so `defined(x)` standing in ordinary C is left
; as it was found, with its argument expanded the way every other identifier
; is, which is what cc does with it there too. Reading the condition and
; evaluating it are one act: what comes back is `1`, `0`, or a text that is
; neither, and the third is what `arms` refuses. `defined` is `known` under
; either key, since a function-like macro is defined too.
@syntax "defined(" x:name ")" => {
    if known("cond") {
        if known("def:" + x) or known("fn:" + x) { emit "1" } else { emit "0" }
    } else { emit "defined(" + expand(x) + ")" }
}

; Conditional inclusion. Each arm is a `raw` hole, so a `#define` inside an
; arm not taken never fires; the arm taken is handed to `expand`, and a
; conditional nested inside it fires then, in its turn. The `#elif` arms are
; a repeated group, so there may be any number of them, and the `#else` is an
; optional group, so a conditional without one is the same rule and not a
; second: a group that takes no turn leaves `t` running to the `#endif`.
;
; The group's word is `"#elif"` and its condition is whatever follows, not
; the readable form, and that is the whole of what keeps a condition these
; rules cannot read from being swallowed into an arm and taken or dropped
; whole with it. A `#elif` at this conditional's own level always ends the
; arm before it, whatever it says, and is then read or refused; one inside a
; *nested* conditional is not at this level, because a hole stops only where
; the declared brackets are balanced, so the nested rule reads it in its turn
; or it goes with the conditional that holds it, which is where cc puts it
; too. Until 2026-09-08 the arms were two `raw` holes and a `@template
; no_elif` read them for the word before either was taken, which could not
; tell those two apart and refused both.
;
; `#ifdef` and `#ifndef` differ in one test, so both call one template. The
; count is a depth this file keeps, exactly as a macro's arguments are keyed
; below: a conditional inside the arm being expanded runs in the middle of
; the loop over the arms and must not see the flag that loop set.
@template conditional(hit, t, c, a, has_else, f) {
    if known("ifdepth") { remember("ifdepth", num(recall("ifdepth")) + 1) }
    else { remember("ifdepth", 1) }
    arms(recall("ifdepth"), hit, t, c, a, has_else, f)
}

@template arms(d, hit, t, c, a, has_else, f) {
    if hit { remember("taken:" + d, "1") emit expand(t) }
    for i, x in c {
        if not known("taken:" + d) {
            remember("cond", "1")
            remember("val:" + d, replace(expand(x), " ", ""))
            forget("cond")
            if recall("val:" + d) == "1" {
                remember("taken:" + d, "1")
                emit expand(at(a, i))
            } else {
                if recall("val:" + d) != "0" {
                    refuse("'#elif" + x + "' is not a condition these rules read -- 'defined(NAME)' is the only one -- and it stands inside a conditional they do read, so an arm holding it would be taken or dropped whole. Write that arm as an '#ifdef' nested in the '#else'.")
                }
            }
        }
    }
    if has_else and not known("taken:" + d) { emit expand(f) }
    forget("taken:" + d)
    forget("val:" + d)
    remember("ifdepth", num(d) - 1)
}

@syntax "#ifdef " n:name "\n" t:raw [ "#elif" c:raw "\n" a:raw ]* [ "#else\n" f:raw ] "#endif\n"
    => { conditional(known("def:" + n) or known("fn:" + n), t, c, a, matched(f), f) }
@syntax "#ifndef " n:name "\n" t:raw [ "#elif" c:raw "\n" a:raw ]* [ "#else\n" f:raw ] "#endif\n"
    => { conditional(not (known("def:" + n) or known("fn:" + n)), t, c, a, matched(f), f) }

; A call. Every call in the file fires this, and one that is not a macro is
; written back as it was. One that is binds each argument to its parameter's
; name and expands the body, and the binding *is* the store: the identifier
; rule below looks a name up as an argument before it looks it up as a
; macro. The bindings are keyed by a depth the file counts, because a body
; may call another macro whose parameter has the same name, `TWICE(x)`
; calling `DOUBLE(x)` below: the inner call's arguments are expanded before
; its template runs, at the outer depth, and its own bindings live one
; deeper and are gone before the outer body's next `x`. That is cpp's
; order, arguments first and the body after. The `busy:` key is the same
; guard the object-like rule has.
; The two operators, meaningful inside a function-like body. `#x` is the
; argument bound to `x`, quoted; a `#` before anything else, `#include
; <stdio.h>` say, goes through as it was, since every directive's own word
; is longer and was tried first. `a ## b` pastes the two sides and rescans
; the result, so `GLUE(LIM, IT)` is `LIMIT` and then 10; each side is run
; through the rules to resolve it as an argument, and its spaces dropped,
; since what pasting makes is one token. Declared before the call and the
; identifier rules, which would otherwise take the left side first.
@syntax "#" x:name => {
    if known("depth") and known("arg:" + recall("depth") + ":" + x) {
        emit "\"" + recall("arg:" + recall("depth") + ":" + x) + "\""
    } else { emit "#" + x }
}
@syntax x:name " ## " y:name => { emit expand(replace(expand(x), " ", "") + replace(expand(y), " ", "")) }
@syntax x:name "##" y:name   => { emit expand(replace(expand(x), " ", "") + replace(expand(y), " ", "")) }

@syntax n:name "(" [ a ]* sep "," ")" => {
    if known("fn:" + n) and not known("busy:" + n) {
        if known("depth") { remember("depth", num(recall("depth")) + 1) } else { remember("depth", 1) }
        for i, v in a { remember("arg:" + recall("depth") + ":" + recall("param:" + n + ":" + i), v) }
        remember("busy:" + n, "1")
        emit expand(recall("fn:" + n))
        forget("busy:" + n)
        for i, v in a { forget("arg:" + recall("depth") + ":" + recall("param:" + n + ":" + i)) }
        remember("depth", num(recall("depth")) - 1)
    } else {
        emit expand(n) + "("
        for v in a sep "," { emit v }
        emit ")"
    }
}

; A name that is a macro is replaced by its body run through these rules
; again, which is cpp's rescan: `#define A B` then `#define B 5` gives `A`
; the value 5, because `B` is looked up when `A` is used and not when it was
; defined. cpp's rule for a body that names its own macro is that the name
; is not expanded again while it is being expanded, which is what stops
; `#define SELF SELF`; here that is a `busy:` key remembered for the
; duration and forgotten after. Without it the depth cap would stop it
; instead, at 64, with an error.
@syntax x:name => {
    if known("depth") and known("arg:" + recall("depth") + ":" + x) {
        emit recall("arg:" + recall("depth") + ":" + x)
    } else {
        if known("def:" + x) and not known("busy:" + x) {
            remember("busy:" + x, "1")
            emit expand(recall("def:" + x))
            forget("busy:" + x)
        } else { emit x }
    }
}
