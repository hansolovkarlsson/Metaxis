; 07-lists.mx -- a hole inside a repeated group is a list in a code template,
; and two holes in one group are two parallel lists that `for i, x in` walks
; in step. A string template sees each list joined and cannot pair them.

@token number "[0-9]+"
@token name   "[A-Za-z_][A-Za-z0-9_]*"
@separator ";" => ";\n"

@syntax "fn" f:name "(" [ p:name ":" t:name ]* sep "," ")"
    => {
        emit f + "("
        if count(p) == 0 { emit "void" }
        for i, x in p sep ", " { emit at(t, i) + " " + x }
        emit ")"
    }
@syntax "sum" [ x ]+ sep ","
    => { emit "0"; for v in x { emit " + " + v } }
@syntax "calc" a "*" b
    => { emit num(a) * num(b) }
@end
fn main();
fn scale(n: int, k: double);
sum 1, 2, 3;
calc 6 * 7
