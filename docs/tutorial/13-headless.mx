; 13-headless.mx -- no rule here can name "before the first statement", so a
; collection nothing splices goes at the start of the output.

@token number "[0-9]+"
@token name   "[A-Za-z_][A-Za-z0-9_]*"
@separator ";" => ";\n"

@syntax "let" v:name "=" e
    => { contribute("vars", "int " + v + ";"); emit v + " = " + e }
@end
let a = 1;
let b = a;
let a = 2
